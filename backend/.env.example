# Copy this file to .env.local in this same folder, then fill in the two values
# from your Supabase project: Settings > API.
#
# Both values are safe to expose in the browser bundle. The anon key is public
# by design; Row Level Security in schema.sql is what protects the data.

VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
